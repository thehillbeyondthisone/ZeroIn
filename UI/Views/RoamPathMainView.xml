<?xml version="1.0" standalone="yes"?>
<Root>
	<View >
		<View layout_borders="Rect(4,0,4,0)" view_layout="horizontal">
			<View layout_borders="Rect(2,2,2,2)">
				<TextView layout_borders="Rect(4,4,4,4)" min_size="Point(75,-1)" value="Path Creator" font="BOLD"/>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)"  value="Core Operations" font="BOLD"/>
					<BorderView>
						<View layout_borders="Rect(4,4,4,4)">
							<Button min_size="Point(110,-1)" name="AddPoint" label="Add"/>
							<Button min_size="Point(110,-1)" name="RemovePoint" label="Remove"/>
							<Button min_size="Point(110,-1)" name="ReversePath" label="Reverse"/>
							<Button min_size="Point(110,-1)" name="RunPath" label="Test / Stop"/>
						</View>
					</BorderView>
				</BorderView>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)"  value="Edit Operations" font="BOLD"/>
					<BorderView>
						<View layout_borders="Rect(4,4,4,4)">
							<Button min_size="Point(110,-1)" name="PickupPoint" label="Pickup"/>
							<Button min_size="Point(110,-1)" name="PlacePoint" label="Place"/>
						</View>
					</BorderView>
				</BorderView>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)"  value="Split Operations" font="BOLD"/>
					<BorderView>
						<View layout_borders="Rect(4,4,4,4)">
							<Button min_size="Point(110,-1)" name="SelectPoint" label="Select"/>
							<Button min_size="Point(110,-1)" name="UnselectPoint" label="Unselect"/>
							<Button min_size="Point(110,-1)" name="SplitPath" label="Split"/>
						</View>
					</BorderView>
				</BorderView>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)"  value="Misc Operations" font="BOLD"/>
					<BorderView>
						<View layout_borders="Rect(4,4,4,4)">
							<Button min_size="Point(110,-1)" name="ToggleLock" label="Toggle Lock"/>
							<Button min_size="Point(110,-1)" name="ToggleLoop" label="Toggle Loop"/>
							<Button min_size="Point(110,-1)" name="ClearPath" label="Clear"/>
						</View>
					</BorderView>
				</BorderView>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)"  value="Info" font="BOLD"/>
					<BorderView>
						<View layout_borders="Rect(4,4,4,4)">
							<View view_layout="horizontal">
								<TextView min_size="Point(75,-1)" value="Points:" font="BOLD"/>
								<HLayoutSpacer/>
								<TextView name="Points" font="BOLD"/>
							</View>
							<View view_layout="horizontal">
								<TextView min_size="Point(75,-1)" value="Reversed:" font="BOLD"/>
								<HLayoutSpacer/>
								<TextView name="IsReversed" font="BOLD"/>
							</View>
							<View view_layout="horizontal">
								<TextView min_size="Point(75,-1)" value="Loop:" font="BOLD"/>
								<HLayoutSpacer/>
								<TextView name="IsLooping" font="BOLD"/>
							</View>
							<View view_layout="horizontal">
								<TextView min_size="Point(75,-1)" value="Locked:" font="BOLD"/>
								<HLayoutSpacer/>
								<TextView name="IsLocked" font="BOLD"/>
							</View>
							<View view_layout="horizontal">
								<TextView min_size="Point(75,-1)" value="Playfield:" font="BOLD"/>
								<HLayoutSpacer/>
								<TextView name="Playfield" font="BOLD"/>
							</View>
						</View>
					</BorderView>
				</BorderView>
			</View>
			<View layout_borders="Rect(6,0,4,0)">
				<TextView layout_borders="Rect(4,4,4,4)" value="Targeting Rules" font="BOLD"/>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)" value="Ignored Names" font="BOLD"/>
					<TextInputView name="IgnoredNames" min_size="Point(200,225)" font="BOLD" feature_flags="TVF_MULTILINE|TVF_ALT_ENTER_MODE|TVF_ACCEPT_TXT_INPUT|TVF_ACCEPT_MOUSE_INPUT|TVF_RENDER_SHADOW"/>
				</BorderView>
				<BorderView layout_borders="Rect(0,4,0,4)">
					<TextView layout_borders="Rect(4,4,4,4)" value="Priority Names" font="BOLD"/>
					<TextInputView name="PriorityNames" font="BOLD" min_size="Point(200,225)" feature_flags="TVF_MULTILINE|TVF_ALT_ENTER_MODE|TVF_ACCEPT_TXT_INPUT|TVF_ACCEPT_MOUSE_INPUT|TVF_RENDER_SHADOW"/>
				</BorderView>
			</View>
		</View>
		<BorderView min_size="Point(333,-1)" layout_borders="Rect(0,4,1,8)">
			<TextView layout_borders="Rect(4,4,4,4)" value="Export / Save Changes" font="BOLD"/>
			<View view_layout="horizontal">
				<TextView value="File Name:"  layout_borders="Rect(4,4,4,4)" />
				<TextInputView name="FileName" min_size="Point(129,16)" max_size="Point(127,16)" layout_borders="Rect(4,4,4,4)"/>
				<Button min_size="Point(110,-1)"  layout_borders="Rect(4,4,4,4)" name="Save" label="Save"/>
			</View>
		</BorderView>
	</View>
</Root>