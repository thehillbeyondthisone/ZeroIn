<?xml version="1.0" standalone="yes"?>
<root>
	<View view_layout="vertical" name="Root">
		<TextView h_alignment="LEFT" label="Scanner Settings" text_style="Bold" layout_borders="Rect(0,0,0,8)"/>

		<!-- Grid Settings -->
		<HLayoutGroup text_alignment="LEFT" name="ScanSpacing" layout_borders="Rect(0,0,0,4)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="Scan Spacing (m)" view_layout="vertical"/>
			<Text_Field name="ScanSpacingValue" text_alignment="LEFT" caption="" value="40" text_style="normal" max_length="3" min_size="Point(40,-1)"/>
		</HLayoutGroup>

		<HLayoutGroup text_alignment="LEFT" name="DetectionRange" layout_borders="Rect(0,0,0,8)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="Detection (m)" view_layout="vertical"/>
			<Text_Field name="DetectionRangeValue" text_alignment="LEFT" caption="" value="50" text_style="normal" max_length="3" min_size="Point(40,-1)"/>
		</HLayoutGroup>

		<!-- Filter Settings -->
		<Checkbox h_alignment="LEFT" label="Only AFK Players" name="OnlyAFK" layout_borders="Rect(0,0,0,4)"/>
		<HLayoutGroup text_alignment="LEFT" name="AFKCheckTime" layout_borders="Rect(0,0,0,8)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="AFK Time (sec)" view_layout="vertical"/>
			<Text_Field name="AFKCheckTimeValue" text_alignment="LEFT" caption="" value="30" text_style="normal" max_length="3" min_size="Point(40,-1)"/>
		</HLayoutGroup>

		<!-- Output Settings -->
		<TextView h_alignment="LEFT" label="Output Formats" text_style="Bold" layout_borders="Rect(0,8,0,4)"/>
		<Checkbox h_alignment="LEFT" label="Save to JSON" name="SaveToJson" layout_borders="Rect(0,0,0,2)"/>
		<Checkbox h_alignment="LEFT" label="Save to CSV" name="SaveToCsv" layout_borders="Rect(0,0,0,2)"/>
		<Checkbox h_alignment="LEFT" label="Log to Console" name="LogToConsole" layout_borders="Rect(0,0,0,8)"/>

		<!-- Continuous Scan -->
		<Checkbox h_alignment="LEFT" label="Continuous Scanning" name="ContinuousScanning" layout_borders="Rect(0,0,0,8)"/>

		<!-- Visual Settings -->
		<TextView h_alignment="LEFT" label="Visual Toggles (Click = Toggle + Chat)" text_style="Bold" layout_borders="Rect(0,8,0,4)"/>
		<Button name="ToggleDetectionRadius" label="Toggle Detection Radius" layout_borders="Rect(0,0,0,2)"/>
		<Button name="TogglePlayerMarkers" label="Toggle Player Markers" layout_borders="Rect(0,0,0,2)"/>
		<Button name="ToggleAFKPaths" label="Toggle AFK Paths" layout_borders="Rect(0,0,0,2)"/>
		<Button name="ToggleTagOnly" label="Toggle Tag-Only Mode" layout_borders="Rect(0,0,0,2)"/>
		<Button name="ToggleActivePlayerPaths" label="Toggle Active Player Paths" layout_borders="Rect(0,0,0,8)"/>

		<!-- Combat Settings -->
		<TextView h_alignment="LEFT" label="Combat Settings" text_style="Bold" layout_borders="Rect(0,8,0,4)"/>
		<Checkbox h_alignment="LEFT" label="Enable Combat (Mob Targeting)" name="EnableCombat" layout_borders="Rect(0,0,0,2)"/>
		<Checkbox h_alignment="LEFT" label="Enable Looting" name="EnableLooting" layout_borders="Rect(0,0,0,2)"/>
		<Checkbox h_alignment="LEFT" label="Auto-Retreat (Low Health/Nano)" name="EnableHealthCheck" layout_borders="Rect(0,0,0,8)"/>

		<!-- Sensor Network Settings -->
		<TextView h_alignment="LEFT" label="Multi-Character Sensor Network" text_style="Bold" layout_borders="Rect(0,8,0,4)"/>
		<Checkbox h_alignment="LEFT" label="Enable Sensor Network" name="EnableSensorNetwork" layout_borders="Rect(0,0,0,2)"/>
		<Checkbox h_alignment="LEFT" label="Act as Controller (receive data)" name="IsController" layout_borders="Rect(0,0,0,4)"/>
		<HLayoutGroup text_alignment="LEFT" name="ControllerUrl" layout_borders="Rect(0,0,0,4)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="Controller URL" view_layout="vertical"/>
			<Text_Field name="ControllerUrlValue" text_alignment="LEFT" caption="" value="http://localhost:8080" text_style="normal" max_length="50" min_size="Point(150,-1)"/>
		</HLayoutGroup>
		<HLayoutGroup text_alignment="LEFT" name="SensorUploadInterval" layout_borders="Rect(0,0,0,4)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="Upload Interval (sec)" view_layout="vertical"/>
			<Text_Field name="SensorUploadIntervalValue" text_alignment="LEFT" caption="" value="5" text_style="normal" max_length="2" min_size="Point(40,-1)"/>
		</HLayoutGroup>

		<!-- Proximity Guard Settings -->
		<TextView h_alignment="LEFT" label="Proximity Guard (Threat Detection)" text_style="Bold" layout_borders="Rect(0,8,0,4)"/>
		<Checkbox h_alignment="LEFT" label="Enable Proximity Guard" name="EnableProximityGuard" layout_borders="Rect(0,0,0,2)"/>
		<HLayoutGroup text_alignment="LEFT" name="ProximityTriggerRange" layout_borders="Rect(0,0,0,4)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="Trigger Range (m)" view_layout="vertical"/>
			<Text_Field name="ProximityTriggerRangeValue" text_alignment="LEFT" caption="" value="50" text_style="normal" max_length="3" min_size="Point(40,-1)"/>
		</HLayoutGroup>
		<HLayoutGroup text_alignment="LEFT" name="ProximityClearSeconds" layout_borders="Rect(0,0,0,4)">
			<TextView text_style="Bold" min_size="Point(120,-1)" label="Clear Time (sec)" view_layout="vertical"/>
			<Text_Field name="ProximityClearSecondsValue" text_alignment="LEFT" caption="" value="8" text_style="normal" max_length="2" min_size="Point(40,-1)"/>
		</HLayoutGroup>
		<Checkbox h_alignment="LEFT" label="Announce Threats to Chat" name="ProximityAnnounceThreats" layout_borders="Rect(0,0,0,2)"/>
		<TextView h_alignment="LEFT" label="Use /proximity help for whitelist commands" text_style="normal" layout_borders="Rect(0,0,0,4)"/>
	</View>
</root>
